# cp infra/env.sh.example infra/env.sh   (infra/env.sh is git-ignored)
export PROJECT_ID="dryrun-hack"          # globally unique; pick yours
export REGION="us-central1"                  # cheapest tier-1 region; Cloud Run + GCS + AR all here
export SERVICE="dryrun"
export REPO="dryrun"                      # Artifact Registry repo
export DATA_BUCKET="${PROJECT_ID}-data"      # private: AOI layers
export RUNS_BUCKET="${PROJECT_ID}-runs"      # public-read: frames/manifests (immutable, content-addressed)
export RUNTIME_SA="dryrun-run@${PROJECT_ID}.iam.gserviceaccount.com"
export BILLING_ACCOUNT=""                    # gcloud billing accounts list
# Hard cap, not an alert: at 100% of this, billing_guard.sh's function UNLINKS billing and
# every paid service in the project stops. Credits are excluded, so this tracks real usage.
export BUDGET_USD=50
export GITHUB_REPO="AKOrojo/dry-run"         # wif.sh restricts CI deploys to this repo only
# What the deployed service runs. Flip to solver / meta / the Lagos AOI at M2 (Thu) and leave them:
# a plain `deploy.sh` during judging must never put the live site back on placeholder physics.
export SIM_BACKEND="fake"
export AGENT_PROVIDER="replay"
export LIVE_PROVIDER="meta"        # the paid model behind the judge key's Live runs
export DEFAULT_AOI="fixture-synthetic"
export AGENT_PER_HOUR=12
export AGENT_PER_DAY=300
export BUILDINGS_URL=""   # optional gzipped footprints URL (see doc 04)
# Teammates' Google accounts (comma-separated) to grant project Editor, e.g.
# "user:ada@gmail.com,user:bo@gmail.com". Leave EMPTY until you have the real addresses:
# a@gmail.com and friends are live accounts owned by strangers, and bootstrap refuses them.
export TEAM_EMAILS=""
