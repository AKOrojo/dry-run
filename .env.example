# Copy to .env (git-ignored). Keep comments on their own lines: the Makefile
# includes this file, and inline comments would leave trailing spaces in values.
# In Cloud Run these come from env vars + Secret Manager instead.

# --- storage: local | gcs ---
DRYRUN_STORAGE=local
DRYRUN_DATA_DIR=data
DRYRUN_RUNS_DIR=runs
# private bucket, e.g. dryrun-data-<project>
DRYRUN_DATA_BUCKET=
# public-read bucket, e.g. dryrun-runs-<project>
DRYRUN_RUNS_BUCKET=
# prod: https://storage.googleapis.com/<runs-bucket>/runs
DRYRUN_PUBLIC_RUNS_BASE=/runs

# --- simulation: fake | solver ;  agent: fake | meta | baseten ---
DRYRUN_SIM_BACKEND=fake
DRYRUN_AGENT_PROVIDER=fake
# becomes lagos-<corridor>-v1 once Eng D publishes real data
DRYRUN_DEFAULT_AOI=fixture-synthetic

# --- Meta Model API (each engineer claims their OWN $150 credits) ---
META_API_KEY=
# verify base URL + model ids on dev.meta.ai on Day 1
META_BASE_URL=https://api.meta.ai/v1
META_AGENT_MODEL=muse-spark-1.3

# --- Baseten (sovereign / open-weights mode) ---
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
# hackathon-specific id from the participant guide (not the one in Baseten docs)
BASETEN_MODEL=meta-models/muse-spark-open-1026

# --- OpenRouter: sovereign mode (Muse Spark Open) until Baseten -1026 is live ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta/muse-spark-open

# --- frontend (Vite reads VITE_*) ---
VITE_API_BASE=
# leave VITE_API_BASE empty: Vite proxies /api and /runs to :8080 in dev, same-origin in prod
# default AOI + agent provider come from the API's /api/config at runtime (no rebuild)
# free Cesium ion token (public client token; restrict allowed URLs in the ion dashboard).
# Served to the browser by /api/config; VITE_ copy is a dev-only override.
CESIUM_ION_TOKEN=
VITE_CESIUM_ION_TOKEN=
# team token: bypasses public rate limits (header X-Team-Token) and protects POST /admin/reload
DRYRUN_ADMIN_TOKEN=
DRYRUN_AGENT_PER_HOUR=12
