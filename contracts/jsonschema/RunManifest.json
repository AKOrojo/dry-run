{
  "$defs": {
    "DrainUpgrade": {
      "additionalProperties": false,
      "description": "No polygon/place = whole AOI.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "drain_upgrade",
          "default": "drain_upgrade",
          "title": "Type",
          "type": "string"
        },
        "capacity_factor": {
          "default": 1.0,
          "description": "multiplies EXISTING drains: 1.4 = +40%",
          "maximum": 5,
          "minimum": 0,
          "title": "Capacity Factor",
          "type": "number"
        },
        "add_mm_h": {
          "default": 0,
          "description": "NEW drainage inside the area (where none is mapped)",
          "maximum": 200,
          "minimum": 0,
          "title": "Add Mm H",
          "type": "number"
        }
      },
      "title": "DrainUpgrade",
      "type": "object"
    },
    "Drainage": {
      "additionalProperties": false,
      "description": "The drain/sewer model (0.8.0). Every field left None takes the AOI's drainage_default.\n\nclosed: rain enters only at inlet cells (catch basins), fills a lumped sewer per zone that empties at a capped\n        rate through its outfall; when full or tide-locked it surcharges back onto the lowest inlet cells.\nopen:   rain enters roadside channels along their open edges (covered sections only through inlets); the\n        channels carry it along the network (Manning) to outfalls and overflow onto the street when full.\nmixed:  both (a what-if, e.g. Lagos with closed sewers under the roads as well).",
      "properties": {
        "system": {
          "anyOf": [
            {
              "enum": [
                "closed",
                "open",
                "mixed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "System"
        },
        "capacity_mm_h": {
          "anyOf": [
            {
              "maximum": 200,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "design rain intensity the system carries (Queens pre-1973 standard 1.5 in/h = 38.1 mm/h). Closed: pipe flow cap = this x runoff coefficient x zone area. Open: scales channel widths relative to the AOI default",
          "title": "Capacity Mm H"
        },
        "return_period_yr": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                5,
                10,
                25,
                50,
                100
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "alternative to capacity_mm_h: the design storm, mapped through drainage_default.design_mm_h_by_return_period (400 if the AOI has no entry for it)",
          "title": "Return Period Yr"
        },
        "blockage_pct": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "share of inlet and channel capacity lost to solid waste and sediment",
          "title": "Blockage Pct"
        },
        "outfall": {
          "default": "tide",
          "description": "tide: water leaves only while the level inside is above the receiving water (lagoon/tide; TideLevel raises it). free: ignore the receiving water. blocked: nothing leaves; the system only stores, then overflows",
          "enum": [
            "tide",
            "free",
            "blocked"
          ],
          "title": "Outfall",
          "type": "string"
        },
        "flap_gates": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outfalls let no outside water back in",
          "title": "Flap Gates"
        },
        "roadside_gutters": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "open/mixed: add inferred drains along drivable roads (OSM maps only 2-3 % of them in Lagos)",
          "title": "Roadside Gutters"
        }
      },
      "title": "Drainage",
      "type": "object"
    },
    "FrameRef": {
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "description": "seconds since storm start",
          "title": "T S",
          "type": "integer"
        },
        "png": {
          "description": "path relative to run folder, e.g. frames/f_0006.png",
          "title": "Png",
          "type": "string"
        },
        "depth": {
          "description": "path to float16 .npy depth grid (metres), for /depth queries",
          "title": "Depth",
          "type": "string"
        }
      },
      "required": [
        "t_s",
        "png",
        "depth"
      ],
      "title": "FrameRef",
      "type": "object"
    },
    "GreenInfrastructure": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "green",
          "default": "green",
          "title": "Type",
          "type": "string"
        },
        "infiltration_mm_h": {
          "default": 40,
          "maximum": 200,
          "minimum": 0,
          "title": "Infiltration Mm H",
          "type": "number"
        },
        "manning": {
          "default": 0.08,
          "maximum": 0.3,
          "minimum": 0.01,
          "title": "Manning",
          "type": "number"
        }
      },
      "title": "GreenInfrastructure",
      "type": "object"
    },
    "RainCell": {
      "additionalProperties": false,
      "description": "Rain from one storm cell. Intensity falls off with distance d from the centre:\ngaussian exp(-2 (d/R)^2), exponential exp(-2 d/R), flat 1 inside R, so R (radius_m) is where a gaussian or\nexponential cell is down to e^-2 = 13.5 % of its peak. Storm.total_mm is the POINT depth at the centre of a\nstationary cell; the rain field preview reports the area-average depth and volume.",
      "properties": {
        "kind": {
          "const": "cell",
          "default": "cell",
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "additionalItems": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(lon, lat) of the cell centre; a moving cell is here at the rain peak (the start for front_loaded, mid-storm otherwise)",
          "title": "Center"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "centre on this `places` feature instead (its centroid)",
          "title": "Place"
        },
        "radius_m": {
          "default": 5000,
          "description": "radar cells are ~35-90 km2: R ~ 3-5 km",
          "maximum": 15000,
          "minimum": 1000,
          "title": "Radius M",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/RainProfile",
          "default": "gaussian"
        },
        "track": {
          "anyOf": [
            {
              "$ref": "#/$defs/StormTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = a stationary cell"
        }
      },
      "title": "RainCell",
      "type": "object"
    },
    "RainPolygon": {
      "additionalProperties": false,
      "description": "Rain only inside an area (uniform there, none outside): a polygon or a `places` name.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "kind": {
          "const": "polygon",
          "default": "polygon",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RainPolygon",
      "type": "object"
    },
    "RainProfile": {
      "enum": [
        "gaussian",
        "exponential",
        "flat"
      ],
      "title": "RainProfile",
      "type": "string"
    },
    "RetentionPond": {
      "additionalProperties": false,
      "description": "Draw on open land. Buildings inside are reported as buildings_in_ponds (displaced), roads are cut.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "pond",
          "default": "pond",
          "title": "Type",
          "type": "string"
        },
        "depth_m": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Depth M",
          "type": "number"
        }
      },
      "title": "RetentionPond",
      "type": "object"
    },
    "RoadClosure": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "road_closure",
          "default": "road_closure",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "RoadClosure",
      "type": "object"
    },
    "RunStats": {
      "additionalProperties": false,
      "description": "Every number the agent is allowed to cite MUST come from here (or RouteResult).",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "buildings_flooded": {
          "description": "buildings whose max depth (3x3 around footprint) >= 0.15 m; at 30 m cells that is flood water within about 45 m, so read it as 'water close by'",
          "title": "Buildings Flooded",
          "type": "integer"
        },
        "buildings_flooded_severe": {
          "description": "max depth >= 0.5 m",
          "title": "Buildings Flooded Severe",
          "type": "integer"
        },
        "buildings_flooded_own_cell": {
          "default": 0,
          "description": "buildings whose OWN cell's max depth >= 0.15 m: stricter than buildings_flooded (3x3), added in contract 0.4.0 (0 on older runs)",
          "title": "Buildings Flooded Own Cell",
          "type": "integer"
        },
        "road_km_impassable": {
          "description": "road length with max depth >= passability threshold",
          "title": "Road Km Impassable",
          "type": "number"
        },
        "people_exposed": {
          "description": "population in cells with max depth >= 0.15 m",
          "title": "People Exposed",
          "type": "integer"
        },
        "flooded_area_km2": {
          "title": "Flooded Area Km2",
          "type": "number"
        },
        "max_depth_m": {
          "title": "Max Depth M",
          "type": "number"
        },
        "peak_t_s": {
          "description": "time of maximum flooded area",
          "title": "Peak T S",
          "type": "integer"
        },
        "rain_volume_m3": {
          "title": "Rain Volume M3",
          "type": "number"
        },
        "rain_generated_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rain the storm produces, including any that falls outside the AOI (spatial rain only; added in 0.6.0)",
          "title": "Rain Generated M3"
        },
        "rain_in_aoi_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rain falling inside the AOI on land and water; rain_volume_m3 is the part applied to land (added in 0.6.0)",
          "title": "Rain In Aoi M3"
        },
        "domain_cells": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cells simulated: the whole grid, or the rain-area window (domain rain_area); added in 0.7.0",
          "title": "Domain Cells"
        },
        "domain_bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "additionalItems": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "lon/lat [w, s, e, n] of the simulated window (domain rain_area); null for domain aoi. Outside it nothing was modelled: frames there hold the t=0 state, and point depths, series and building depths are null. Added in 0.7.0",
          "title": "Domain Bbox"
        },
        "inflow_volume_m3": {
          "default": 0.0,
          "description": "river inflow entering the domain (gauge hydrograph); added in contract 0.5.0 (0 on older runs and on AOIs without inflows)",
          "title": "Inflow Volume M3",
          "type": "number"
        },
        "drained_volume_m3": {
          "title": "Drained Volume M3",
          "type": "number"
        },
        "infiltrated_volume_m3": {
          "title": "Infiltrated Volume M3",
          "type": "number"
        },
        "stored_volume_end_m3": {
          "title": "Stored Volume End M3",
          "type": "number"
        },
        "boundary_outflow_m3": {
          "description": "water leaving through the lagoon/edge boundary",
          "title": "Boundary Outflow M3",
          "type": "number"
        },
        "mass_balance_error_pct": {
          "description": "100*(rain + inflow - drained - infiltrated - outflow - stored_end) / (rain + inflow); solver sanity check, |err| should be < 1%",
          "title": "Mass Balance Error Pct",
          "type": "number"
        },
        "buildings_in_ponds": {
          "default": 0,
          "description": "buildings inside pond polygons (displaced, not 'saved')",
          "title": "Buildings In Ponds",
          "type": "integer"
        },
        "passability_threshold_m": {
          "default": 0.3,
          "title": "Passability Threshold M",
          "type": "number"
        },
        "is_surrogate": {
          "default": false,
          "description": "True if produced by the ML emulator, not the solver",
          "title": "Is Surrogate",
          "type": "boolean"
        },
        "sewer_captured_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GROSS surface water taken in by inlets and open drains: water that overflows and is taken in again counts each time. Net taken off the streets = drained_volume_m3",
          "title": "Sewer Captured M3"
        },
        "sewer_surcharge_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "water pushed back onto the street (system full or outfall drowned)",
          "title": "Sewer Surcharge M3"
        },
        "drain_outfall_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "left through outfalls (net: negative if the receiving water flowed in)",
          "title": "Drain Outfall M3"
        },
        "drain_storage_end_m3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "water gained by pipes and channels since the start (tidal water already in channels at t=0 not counted)",
          "title": "Drain Storage End M3"
        },
        "drain_peak_full_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "peak system-wide fill, 0-100",
          "title": "Drain Peak Full Pct"
        },
        "drain_full_t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "first time the system was >= 95 % full; null if never",
          "title": "Drain Full T S"
        },
        "drain_surcharge_start_t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "first time water overflowed onto the street",
          "title": "Drain Surcharge Start T S"
        },
        "drain_surcharge_end_t_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "last time water overflowed onto the street",
          "title": "Drain Surcharge End T S"
        }
      },
      "required": [
        "run_id",
        "buildings_flooded",
        "buildings_flooded_severe",
        "road_km_impassable",
        "people_exposed",
        "flooded_area_km2",
        "max_depth_m",
        "peak_t_s",
        "rain_volume_m3",
        "drained_volume_m3",
        "infiltrated_volume_m3",
        "stored_volume_end_m3",
        "boundary_outflow_m3",
        "mass_balance_error_pct"
      ],
      "title": "RunStats",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ScenarioSpec": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "default": "0.8.0",
          "title": "Contract Version",
          "type": "string"
        },
        "aoi_id": {
          "title": "Aoi Id",
          "type": "string"
        },
        "storm": {
          "$ref": "#/$defs/Storm"
        },
        "interventions": {
          "items": {
            "discriminator": {
              "mapping": {
                "drain_upgrade": "#/$defs/DrainUpgrade",
                "green": "#/$defs/GreenInfrastructure",
                "pond": "#/$defs/RetentionPond",
                "road_closure": "#/$defs/RoadClosure",
                "tide": "#/$defs/TideLevel"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DrainUpgrade"
              },
              {
                "$ref": "#/$defs/GreenInfrastructure"
              },
              {
                "$ref": "#/$defs/RetentionPond"
              },
              {
                "$ref": "#/$defs/TideLevel"
              },
              {
                "$ref": "#/$defs/RoadClosure"
              }
            ]
          },
          "title": "Interventions",
          "type": "array"
        },
        "sim_hours": {
          "default": 6,
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Sim Hours",
          "type": "number"
        },
        "output_interval_min": {
          "default": 10,
          "maximum": 60,
          "minimum": 5,
          "title": "Output Interval Min",
          "type": "integer"
        },
        "domain": {
          "default": "aoi",
          "description": "aoi: simulate the whole grid. rain_area: only the cells the storm's rain area wets (storm.spatial), plus a 1 km buffer; water reaching the window edge flows out and is counted. Faster for a small storm; flow from outside the window is not modelled. Not available on river AOIs (AOIManifest.layers has 'inflows'): 400.",
          "enum": [
            "aoi",
            "rain_area"
          ],
          "title": "Domain",
          "type": "string"
        },
        "drainage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Drainage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the drain/sewer model. None = the AOI's drainage_default if it has one, else the constant drain_sink_mm_h (older AOIs). On an AOI without drainage_default a Drainage is a 400. Added in 0.8.0"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 60,
              "pattern": "^[\\w .,+%()/\u00d7-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "human label; NOT part of run_id",
          "title": "Label"
        }
      },
      "required": [
        "aoi_id",
        "storm"
      ],
      "title": "ScenarioSpec",
      "type": "object"
    },
    "Storm": {
      "additionalProperties": false,
      "properties": {
        "total_mm": {
          "description": "rain depth over the storm: everywhere by default; inside the polygon for a rain polygon; at the centre of a stationary rain cell (a point depth, so the area average is lower)",
          "examples": [
            120
          ],
          "maximum": 600,
          "minimum": 0,
          "title": "Total Mm",
          "type": "number"
        },
        "duration_h": {
          "examples": [
            3
          ],
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Duration H",
          "type": "number"
        },
        "pattern": {
          "$ref": "#/$defs/StormPattern",
          "default": "center_peaked"
        },
        "spatial": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cell": "#/$defs/RainCell",
                  "polygon": "#/$defs/RainPolygon"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RainCell"
                },
                {
                  "$ref": "#/$defs/RainPolygon"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where the rain falls; None = the whole area",
          "title": "Spatial"
        }
      },
      "required": [
        "total_mm",
        "duration_h"
      ],
      "title": "Storm",
      "type": "object"
    },
    "StormPattern": {
      "enum": [
        "uniform",
        "front_loaded",
        "center_peaked"
      ],
      "title": "StormPattern",
      "type": "string"
    },
    "StormTrack": {
      "additionalProperties": false,
      "description": "A moving storm cell: the centre starts at RainCell.center and travels in a straight line.",
      "properties": {
        "heading_deg": {
          "description": "direction the cell moves TOWARD, compass degrees (0 = north, 90 = east, 270 = west)",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Heading Deg",
          "type": "number"
        },
        "speed_m_s": {
          "description": "West African squall lines move ~11-18 m/s westward",
          "maximum": 20,
          "minimum": 0,
          "title": "Speed M S",
          "type": "number"
        }
      },
      "required": [
        "heading_deg",
        "speed_m_s"
      ],
      "title": "StormTrack",
      "type": "object"
    },
    "TideLevel": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tide",
          "default": "tide",
          "title": "Type",
          "type": "string"
        },
        "boundary_level_m": {
          "description": "water level at outflow boundary",
          "maximum": 5,
          "minimum": -2,
          "title": "Boundary Level M",
          "type": "number"
        }
      },
      "required": [
        "boundary_level_m"
      ],
      "title": "TideLevel",
      "type": "object"
    },
    "Timeseries": {
      "additionalProperties": false,
      "description": "Per-frame series for charts and event markers on the shared clock (same order as frames).",
      "properties": {
        "t_s": {
          "items": {
            "type": "integer"
          },
          "title": "T S",
          "type": "array"
        },
        "flooded_area_km2": {
          "items": {
            "type": "number"
          },
          "title": "Flooded Area Km2",
          "type": "array"
        },
        "road_km_impassable": {
          "items": {
            "type": "number"
          },
          "title": "Road Km Impassable",
          "type": "array"
        },
        "edges_cut": {
          "items": {
            "type": "integer"
          },
          "title": "Edges Cut",
          "type": "array"
        },
        "drain_full_pct": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "system-wide drain fill, 0-100 (0.8.0)",
          "title": "Drain Full Pct"
        },
        "drain_outfall_m3_s": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "outfall discharge, m3/s (0.8.0)",
          "title": "Drain Outfall M3 S"
        },
        "surcharge_m3_s": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "overflow back onto the street, m3/s (0.8.0)",
          "title": "Surcharge M3 S"
        }
      },
      "required": [
        "t_s",
        "flooded_area_km2",
        "road_km_impassable",
        "edges_cut"
      ],
      "title": "Timeseries",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "gs://<runs-bucket>/runs/<run_id>/manifest.json",
  "properties": {
    "contract_version": {
      "default": "0.8.0",
      "title": "Contract Version",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "scenario": {
      "$ref": "#/$defs/ScenarioSpec"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/FrameRef"
      },
      "title": "Frames",
      "type": "array"
    },
    "max_depth_png": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Depth Png"
    },
    "intervention_cells": {
      "description": "grid cells whose inputs each intervention actually CHANGED (0 = no effect)",
      "items": {
        "type": "integer"
      },
      "title": "Intervention Cells",
      "type": "array"
    },
    "timeseries": {
      "anyOf": [
        {
          "$ref": "#/$defs/Timeseries"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "building_depths": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "JSON {\"ids\": [...], \"max_depth_m\": [...]} per building; the UI joins by id to the buildings_geojson features and colours extrusions with it",
      "title": "Building Depths"
    },
    "stats": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunStats"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "colormap": {
      "additionalProperties": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "description": "bin edges used to colour the PNGs; UI legend reads this",
      "title": "Colormap",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "drain_fill": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "path to drain_fill.json (DrainFill): per-frame fill of every drain line and sewer zone. Null without the drainage model. Added in 0.8.0",
      "title": "Drain Fill"
    },
    "drainage_limits": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "what this run's drainage model cannot claim, one sentence each (the AOI's limits plus scenario-specific ones). Added in 0.8.0",
      "title": "Drainage Limits"
    },
    "backend": {
      "default": "fake",
      "enum": [
        "fake",
        "solver",
        "surrogate"
      ],
      "title": "Backend",
      "type": "string"
    },
    "elapsed_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed S"
    }
  },
  "required": [
    "run_id",
    "scenario",
    "status"
  ],
  "title": "RunManifest",
  "type": "object"
}