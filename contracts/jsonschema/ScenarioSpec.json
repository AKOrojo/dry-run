{
  "$defs": {
    "DrainUpgrade": {
      "additionalProperties": false,
      "description": "No polygon/place = whole AOI.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "drain_upgrade",
          "default": "drain_upgrade",
          "title": "Type",
          "type": "string"
        },
        "capacity_factor": {
          "default": 1.0,
          "description": "multiplies EXISTING drains: 1.4 = +40%",
          "maximum": 5,
          "minimum": 0,
          "title": "Capacity Factor",
          "type": "number"
        },
        "add_mm_h": {
          "default": 0,
          "description": "NEW drainage inside the area (where none is mapped)",
          "maximum": 200,
          "minimum": 0,
          "title": "Add Mm H",
          "type": "number"
        }
      },
      "title": "DrainUpgrade",
      "type": "object"
    },
    "GreenInfrastructure": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "green",
          "default": "green",
          "title": "Type",
          "type": "string"
        },
        "infiltration_mm_h": {
          "default": 40,
          "maximum": 200,
          "minimum": 0,
          "title": "Infiltration Mm H",
          "type": "number"
        },
        "manning": {
          "default": 0.08,
          "maximum": 0.3,
          "minimum": 0.01,
          "title": "Manning",
          "type": "number"
        }
      },
      "title": "GreenInfrastructure",
      "type": "object"
    },
    "RainCell": {
      "additionalProperties": false,
      "description": "Rain from one storm cell. Intensity falls off with distance d from the centre:\ngaussian exp(-2 (d/R)^2), exponential exp(-2 d/R), flat 1 inside R, so R (radius_m) is where a gaussian or\nexponential cell is down to e^-2 = 13.5 % of its peak. Storm.total_mm is the POINT depth at the centre of a\nstationary cell; the rain field preview reports the area-average depth and volume.",
      "properties": {
        "kind": {
          "const": "cell",
          "default": "cell",
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "additionalItems": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "(lon, lat) of the cell centre; a moving cell is here at the rain peak (the start for front_loaded, mid-storm otherwise)",
          "title": "Center"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "centre on this `places` feature instead (its centroid)",
          "title": "Place"
        },
        "radius_m": {
          "default": 5000,
          "description": "radar cells are ~35-90 km2: R ~ 3-5 km",
          "maximum": 15000,
          "minimum": 1000,
          "title": "Radius M",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/RainProfile",
          "default": "gaussian"
        },
        "track": {
          "anyOf": [
            {
              "$ref": "#/$defs/StormTrack"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = a stationary cell"
        }
      },
      "title": "RainCell",
      "type": "object"
    },
    "RainPolygon": {
      "additionalProperties": false,
      "description": "Rain only inside an area (uniform there, none outside): a polygon or a `places` name.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "kind": {
          "const": "polygon",
          "default": "polygon",
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "RainPolygon",
      "type": "object"
    },
    "RainProfile": {
      "enum": [
        "gaussian",
        "exponential",
        "flat"
      ],
      "title": "RainProfile",
      "type": "string"
    },
    "RetentionPond": {
      "additionalProperties": false,
      "description": "Draw on open land. Buildings inside are reported as buildings_in_ponds (displaced), roads are cut.",
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "pond",
          "default": "pond",
          "title": "Type",
          "type": "string"
        },
        "depth_m": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Depth M",
          "type": "number"
        }
      },
      "title": "RetentionPond",
      "type": "object"
    },
    "RoadClosure": {
      "additionalProperties": false,
      "properties": {
        "polygon": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "additionalItems": false
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "place": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "name from get_aoi_info places",
          "title": "Place"
        },
        "type": {
          "const": "road_closure",
          "default": "road_closure",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "RoadClosure",
      "type": "object"
    },
    "Storm": {
      "additionalProperties": false,
      "properties": {
        "total_mm": {
          "description": "rain depth over the storm: everywhere by default; inside the polygon for a rain polygon; at the centre of a stationary rain cell (a point depth, so the area average is lower)",
          "examples": [
            120
          ],
          "maximum": 600,
          "minimum": 0,
          "title": "Total Mm",
          "type": "number"
        },
        "duration_h": {
          "examples": [
            3
          ],
          "exclusiveMinimum": 0,
          "maximum": 12,
          "title": "Duration H",
          "type": "number"
        },
        "pattern": {
          "$ref": "#/$defs/StormPattern",
          "default": "center_peaked"
        },
        "spatial": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "cell": "#/$defs/RainCell",
                  "polygon": "#/$defs/RainPolygon"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/RainCell"
                },
                {
                  "$ref": "#/$defs/RainPolygon"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "where the rain falls; None = the whole area",
          "title": "Spatial"
        }
      },
      "required": [
        "total_mm",
        "duration_h"
      ],
      "title": "Storm",
      "type": "object"
    },
    "StormPattern": {
      "enum": [
        "uniform",
        "front_loaded",
        "center_peaked"
      ],
      "title": "StormPattern",
      "type": "string"
    },
    "StormTrack": {
      "additionalProperties": false,
      "description": "A moving storm cell: the centre starts at RainCell.center and travels in a straight line.",
      "properties": {
        "heading_deg": {
          "description": "direction the cell moves TOWARD, compass degrees (0 = north, 90 = east, 270 = west)",
          "exclusiveMaximum": 360,
          "minimum": 0,
          "title": "Heading Deg",
          "type": "number"
        },
        "speed_m_s": {
          "description": "West African squall lines move ~11-18 m/s westward",
          "maximum": 20,
          "minimum": 0,
          "title": "Speed M S",
          "type": "number"
        }
      },
      "required": [
        "heading_deg",
        "speed_m_s"
      ],
      "title": "StormTrack",
      "type": "object"
    },
    "TideLevel": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tide",
          "default": "tide",
          "title": "Type",
          "type": "string"
        },
        "boundary_level_m": {
          "description": "water level at outflow boundary",
          "maximum": 5,
          "minimum": -2,
          "title": "Boundary Level M",
          "type": "number"
        }
      },
      "required": [
        "boundary_level_m"
      ],
      "title": "TideLevel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "default": "0.7.0",
      "title": "Contract Version",
      "type": "string"
    },
    "aoi_id": {
      "title": "Aoi Id",
      "type": "string"
    },
    "storm": {
      "$ref": "#/$defs/Storm"
    },
    "interventions": {
      "items": {
        "discriminator": {
          "mapping": {
            "drain_upgrade": "#/$defs/DrainUpgrade",
            "green": "#/$defs/GreenInfrastructure",
            "pond": "#/$defs/RetentionPond",
            "road_closure": "#/$defs/RoadClosure",
            "tide": "#/$defs/TideLevel"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DrainUpgrade"
          },
          {
            "$ref": "#/$defs/GreenInfrastructure"
          },
          {
            "$ref": "#/$defs/RetentionPond"
          },
          {
            "$ref": "#/$defs/TideLevel"
          },
          {
            "$ref": "#/$defs/RoadClosure"
          }
        ]
      },
      "title": "Interventions",
      "type": "array"
    },
    "sim_hours": {
      "default": 6,
      "exclusiveMinimum": 0,
      "maximum": 12,
      "title": "Sim Hours",
      "type": "number"
    },
    "output_interval_min": {
      "default": 10,
      "maximum": 60,
      "minimum": 5,
      "title": "Output Interval Min",
      "type": "integer"
    },
    "domain": {
      "default": "aoi",
      "description": "aoi: simulate the whole grid. rain_area: only the cells the storm's rain area wets (storm.spatial), plus a 1 km buffer; water reaching the window edge flows out and is counted. Faster for a small storm; flow from outside the window is not modelled. Not available on river AOIs (AOIManifest.layers has 'inflows'): 400.",
      "enum": [
        "aoi",
        "rain_area"
      ],
      "title": "Domain",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "maxLength": 60,
          "pattern": "^[\\w .,+%()/\u00d7-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "human label; NOT part of run_id",
      "title": "Label"
    }
  },
  "required": [
    "aoi_id",
    "storm"
  ],
  "title": "ScenarioSpec",
  "type": "object"
}